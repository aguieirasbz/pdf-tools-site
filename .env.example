# Copie para .env e preencha com os dados reais. Nunca envie .env ao Git.
DB_HOST=localhost
DB_NAME=SEUUSUARIO_pdftrue_noticias
DB_USER=SEUUSUARIO_usuario_mysql
DB_PASSWORD=SUA_SENHA_MYSQL

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Ordem de tentativa quando o Gemini estiver temporariamente indisponível.
GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash
PEXELS_API_KEY=
# Caminho do cacert.pem no Windows. Exemplo: C:/projetos_andre/pdf-tools-site/certs/cacert.pem
CURL_CAINFO=
AUTO_NEWS_ENABLED=false

ADMIN_EMAIL=seu-email@dominio.com
ADMIN_PASSWORD_HASH=
